# MongoDB connection string
# Use a hostname or service name reachable from the application.
MONGODB_URI=mongodb://user:password@db.example.test:27017/gamex?authSource=admin

# Server port (default: 8082)
PORT=8082

# Node environment
NODE_ENV=production

# Admin email allowlist (preferred provider-neutral name). If this is omitted,
# CF_ACCESS_ALLOWED_EMAILS remains supported for existing deployments.
ADMIN_ALLOWED_EMAILS=you@example.com

# Cloudflare Access defense-in-depth for admin routes
# Team domain: https://<team-name>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# Application Audience (AUD) tag(s) from the Cloudflare Access application(s).
# Comma-separate values if the admin UI and API use separate Access applications.
CF_ACCESS_AUDIENCE=replace-with-cloudflare-access-audience-tag
# Legacy admin allowlist name. Keep it equal to ADMIN_ALLOWED_EMAILS if set.
CF_ACCESS_ALLOWED_EMAILS=you@example.com

# Optional GuessX player accounts (Google OAuth)
# Create a distinct Google OAuth web client per environment. Do not use the
# Cloudflare Access IdP credentials here.
AUTH_SECRET=replace-with-a-random-32-byte-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
# Set to the exact external URL for the current environment.
AUTH_URL=https://guessx.example.com
# Required when the app is behind a trusted reverse proxy/tunnel that forwards
# the public Host header (for example, the Cloudflare Tunnel deployment).
AUTH_TRUST_HOST=true
